# ======================================================================
# 🌾 UZHAVAN AI - Comprehensive .gitignore for GitHub
# ======================================================================

# ---- Environment & Secrets ----
.env
.env*.local
.env.production
.env.development
*.env
!.env.example
secrets/
*.pem
*.key

# ---- Python & Virtual Environments ----
__pycache__/
*.py[cod]
*$py.class
*.pyd
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/
.venv*/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
pip-log.txt
pip-delete-this-directory.txt

# ---- Compiled Binaries, Executables & Archives ----
*.exe
*.dll
*.so
*.dylib
*.msi
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# ---- Machine Learning Models & Heavy Checkpoints ----
# (Store in Hugging Face / external storage or release assets, not in git repo)
models/asr/
models/dialect/
models/intent/
models/crop_disease/
*.pt
*.pth
*.bin
*.safetensors
*.onnx
*.h5
*.keras
*.tflite
*.pkl
*.joblib
*.ckpt
checkpoints/

# Keep model JSON configurations / metadata templates
!models/**/.gitkeep
!models/crop_recommender/*.json

# ---- Datasets & Raw Media ----
datasets/
data/
datasets/tamil_rural/train/audio/
datasets/tamil_rural/validation/audio/
datasets/tamil_rural/test/audio/
datasets/raw/
datasets/downloads/
data_collection/storage/recordings/
*.wav
*.mp3
*.ogg
*.flac
*.m4a

# ---- Temporary Uploads & TTS Audio Cache ----
temp_uploads/
tmp/
temp/
*.tmp

# ---- Databases & Vector Stores ----
*.db
*.sqlite
*.sqlite3
rag/chroma_db/
backend/database/*.db
!backend/database/.gitkeep

# ---- Evaluation & Training Results ----
results/
wandb/
runs/
tensorboard_logs/

# ---- Node & Frontend ----
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.next/
frontend/build/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- IDE & Editor Artifacts ----
.vscode/
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*.swn
*~
*.sublime-project
*.sublime-workspace
.project
.pydevproject
.settings/

# ---- Operating System Specific ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---- Jupyter Notebooks ----
.ipynb_checkpoints/
*-checkpoint.ipynb

# ---- Test & Coverage ----
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/

# ---- Logs ----
*.log
logs/
