# ============================================
# 🌾 UZHAVAN AI - Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# ---- Hugging Face (for gated datasets/models) ----
HF_TOKEN=your_huggingface_token_here

# ---- API Keys (optional, for enhanced features) ----
# Weather API (OpenWeatherMap)
WEATHER_API_KEY=your_openweathermap_api_key_here

# Market Price API (optional)
MARKET_API_KEY=your_market_api_key_here

# LLM API (optional, for RAG response generation)
# Only needed if using API-based LLM instead of templates
GEMINI_API_KEY=your_gemini_api_key_here

# ---- Backend Configuration ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DEBUG=true

# ---- Model Paths ----
ASR_MODEL_PATH=models/asr/best_model
DIALECT_MODEL_PATH=models/dialect/best_dialect_model.pt
INTENT_MODEL_PATH=models/intent/best_intent_model.pt
CROP_MODEL_PATH=models/crop_disease/best_crop_model.pt

# ---- Database ----
CHROMA_DB_PATH=rag/chroma_db
HISTORY_DB_PATH=backend/database/history.db

# ---- Audio Configuration ----
MAX_AUDIO_SIZE_MB=10
MAX_IMAGE_SIZE_MB=5
AUDIO_SAMPLE_RATE=16000

# ---- Privacy ----
REQUIRE_CONSENT=true
ANONYMIZE_SPEAKERS=true
AUTO_DELETE_RECORDINGS_DAYS=30

# ---- GPU Configuration ----
CUDA_VISIBLE_DEVICES=0
USE_FP16=true
